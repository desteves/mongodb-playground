#!/usr/bin/env bash
# Refuses a commit that contains a file or a piece of text that must never be public:
# Terraform plan or state files, .env and tfvars files, private keys, and database or API credentials.
# (A saved plan file holds the whole Terraform state, so one committed by mistake leaks every secret.)
# Install once with scripts/install-hooks.sh. Override a false alarm with `git commit --no-verify`.
set -u
cd "$(git rev-parse --show-toplevel)"
fail=0

staged="$(git diff --cached --name-only --diff-filter=ACMR)"

# 1. Files that are never committed (the *.example templates are fine).
bad="$(printf '%s\n' "$staged" \
  | grep -vE '\.example$' \
  | grep -E '(^|/)(\.env|\.env\..+|[^/]*\.tfvars|[^/]*\.tfvars\.json|[^/]*\.tfstate(\..+)?|[^/]*\.tfplan|tfplan[^/]*|[^/]*\.pem|[^/]*\.p12|id_rsa|id_ed25519)$' || true)"
if [ -n "$bad" ]; then
  echo "pre-commit: these files must never be committed:" >&2
  printf '  %s\n' $bad >&2
  echo "  (a plan or state file contains every secret Terraform manages; keep plans outside the repo: scripts/tf.sh)" >&2
  fail=1
fi

# 2. Credentials in the added lines (never printed back).
if ! git diff --cached -U0 --no-color | python3 -c '
import re, sys
conn = re.compile(r"mongodb(?:\+srv)?://([^/\s:@\"<>*$%{}]+):([^@\s\"<>*$%{}]+)@")
fine = {"password", "pass", "secret", "changeme", "example", "yourpassword"}
rules = [
    ("a private key", re.compile(r"-----BEGIN [A-Z ]*PRIVATE KEY-----")),
    ("a Cloudflare API token", re.compile(r"cf[a-z]t_[A-Za-z0-9]{20,}")),
    ("a GitHub token", re.compile(r"gh[pousr]_[A-Za-z0-9]{30,}")),
    ("an AWS access key", re.compile(r"AKIA[0-9A-Z]{16}")),
]
found = set()
for line in sys.stdin:
    if not line.startswith("+") or line.startswith("+++"):
        continue
    for m in conn.finditer(line):
        pw = m.group(2).lower()
        if pw not in fine and not re.fullmatch(r"x+", pw):
            found.add("a MongoDB connection string with a password")
    for label, rx in rules:
        if rx.search(line):
            found.add(label)
for label in sorted(found):
    print("pre-commit: staged changes contain " + label, file=sys.stderr)
sys.exit(1 if found else 0)
'; then
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo "pre-commit: commit blocked. Remove the secret (and rotate it if it was ever pushed), or use --no-verify for a false alarm." >&2
  exit 1
fi
