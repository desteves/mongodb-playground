{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MongoDB Playground",
  "version": "0.3.0",
  "identifier": "com.mongoplayground.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ../web",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      { "title": "MongoDB Playground", "width": 1280, "height": 800, "minWidth": 800, "minHeight": 500 }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
