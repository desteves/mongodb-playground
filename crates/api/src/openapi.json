{
  "openapi": "3.1.0",
  "info": {
    "title": "MongoDB Playground API",
    "version": "0.2.0",
    "description": "An online MongoDB playground for browsers and agents: run mongosh-style scripts (several statements, in order) against documents you supply, in a throwaway database, with query plans. See /llms.txt and the MCP endpoint at POST /api/v1/mcp."
  },
  "paths": {
    "/api/v1/limits": {
      "get": {
        "operationId": "getLimits",
        "summary": "Hard limits applied to every run",
        "responses": {
          "200": {
            "description": "Limits",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Limits"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/examples": {
      "get": {
        "operationId": "listExamples",
        "summary": "Ready-to-run example requests",
        "responses": {
          "200": {
            "description": "Examples",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Example"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/validate": {
      "post": {
        "operationId": "validateQuery",
        "summary": "Check a request without running it (no database access)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Playground"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Valid",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateResponse"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/run": {
      "post": {
        "operationId": "runQuery",
        "summary": "Run a query in a throwaway database",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Playground"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reply"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "408": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/mcp": {
      "post": {
        "operationId": "mcp",
        "summary": "Model Context Protocol endpoint (Streamable HTTP, stateless)",
        "description": "JSON-RPC 2.0. Methods: initialize, ping, tools/list, tools/call. Tools: run_query, validate_query, explain_query, share_query, get_shared, export_playground, list_examples, get_setup_guide, get_limits.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC response"
          },
          "202": {
            "description": "Notification accepted"
          }
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": {
        "operationId": "getOpenApi",
        "summary": "This document (also served at /openapi.json)",
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 JSON"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "operationId": "healthz",
        "summary": "Liveness",
        "responses": {
          "200": {
            "description": "ok"
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "readyz",
        "summary": "Readiness (pings MongoDB)",
        "responses": {
          "200": {
            "description": "ok"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/explain": {
      "post": {
        "operationId": "explainQuery",
        "summary": "Query plan only (no results). Writes are explained, not performed. Defaults to executionStats.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Playground"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Plan and summary",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Reply"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/share": {
      "post": {
        "operationId": "shareQuery",
        "summary": "Save a valid playground under a random UUID link",
        "description": "Same fields as /run. Text fields are stored exactly as sent. Every call returns a new random UUID (v4) id. Links expire after 90 days without a view.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Playground"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Saved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "url": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/p/{id}": {
      "get": {
        "operationId": "getShared",
        "summary": "Load a shared playground",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The playground as saved (immutable, cacheable for a year). Pass it to /run as-is, without id and createdAt.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Playground"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/events": {
      "post": {
        "operationId": "reportEvent",
        "summary": "Report a UI interaction for usage stats (metadata only)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "page_view",
                      "format",
                      "mode_change",
                      "example_open",
                      "datasource_change",
                      "tab_change",
                      "copy_link"
                    ]
                  },
                  "mode": {
                    "type": "string"
                  },
                  "datasource": {
                    "type": "string"
                  },
                  "exampleId": {
                    "type": "string"
                  },
                  "shareId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Recorded"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/samples": {
      "get": {
        "operationId": "listSamples",
        "summary": "Atlas sample databases available for read-only queries",
        "responses": {
          "200": {
            "description": "Databases and collections",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "available": {
                      "type": "boolean"
                    },
                    "databases": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "collections": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "definition": {
                            "type": "boolean",
                            "description": "True when GET /api/v1/samples/{db} returns the dataset's documents and indexes (the prebuilt sample_playground)."
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/samples/{db}": {
      "get": {
        "operationId": "getSampleDefinition",
        "summary": "Documents and search indexes of the prebuilt sample dataset",
        "description": "Only for the prebuilt, already indexed dataset sample_playground (the examples prebuilt-atlas-search and prebuilt-vector-search read it). Returns the documents and the Atlas Search / Vector Search index definition of each collection. 404 for any other database, when sample data is off, or when the dataset has not been seeded.",
        "parameters": [
          {
            "name": "db",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The dataset",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "database": {
                      "type": "string"
                    },
                    "collections": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "documents": {
                            "type": "array",
                            "items": {
                              "type": "object"
                            }
                          },
                          "searchIndex": {
                            "type": "object"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/samples/{db}/{collection}": {
      "get": {
        "operationId": "previewSample",
        "summary": "Three random documents from a sample collection",
        "parameters": [
          {
            "name": "db",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "collection",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Documents"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/guide": {
      "get": {
        "operationId": "getSetupGuide",
        "summary": "How to run it yourself, get a free or ephemeral Atlas cluster, or connect an agent",
        "description": "Options with exact commands and links: hosted, MCP, Atlas CLI local deployment, free-forever Atlas M0 (with the sign-up link and UTM parameters), ephemeral Atlas cluster, Docker Compose, desktop app.",
        "responses": {
          "200": {
            "description": "The guide",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/mcp.json": {
      "get": {
        "operationId": "getMcpCard",
        "summary": "MCP discovery card",
        "responses": {
          "200": {
            "description": "name, transport, url, tools, docs, openapi, setupGuide",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/export": {
      "post": {
        "operationId": "exportPlayground",
        "summary": "Take a playground out of the site: a mongosh script or the data as JSON",
        "description": "Body: {script, config (the data panel), format: \"mongosh\" | \"json\"}. Returns {format, filename, mimeType, content}. A mongosh export is a script that recreates the data, indexes and statements against any MongoDB (run it with `mongosh <uri> --file playground.js`).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "script": {
                    "type": "string"
                  },
                  "config": {},
                  "format": {
                    "enum": [
                      "mongosh",
                      "json"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The export",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "format": {
                      "type": "string"
                    },
                    "filename": {
                      "type": "string"
                    },
                    "mimeType": {
                      "type": "string"
                    },
                    "content": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/format": {
      "post": {
        "operationId": "formatText",
        "summary": "Tidy the data panel or a mongosh script",
        "description": "Re-indents and re-wraps relaxed JSON (the data panel) or shell statements: short objects, arrays and calls stay on one line, longer ones break one item per line. Comments, strings, regex literals and every token are kept; only whitespace and trailing commas change, and the result is checked against the input before it is returned. Nothing is run or stored. Text that is not well formed (an unclosed bracket, string or comment) is a 422 that names the line.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "text"
                ],
                "additionalProperties": false,
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "The data panel text or the shell script, up to 1 MB."
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 20,
                    "maximum": 200,
                    "default": 80,
                    "description": "Roughly how many columns a line may use before it is broken."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tidied text",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "changed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/verify": {
      "post": {
        "operationId": "verifyTurnstile",
        "summary": "Exchange a Cloudflare Turnstile token for a one-hour session (higher rate-limit tier)",
        "description": "Browsers only. Agents do not need it: without a session you are on the basic rate-limit tier. Returns {verificationRequired, session, expiresAt, expiresInSeconds}; send the session as the X-Playground-Session header.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Session, or verificationRequired false when Turnstile is not configured"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "responses": {
      "Error": {
        "description": "Structured error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "Mode": {
        "type": "string",
        "enum": [
          "find",
          "aggregate",
          "count",
          "distinct",
          "insert",
          "update",
          "delete",
          "listIndexes"
        ]
      },
      "RunRequest": {
        "type": "object",
        "required": [
          "mode",
          "collection",
          "query"
        ],
        "properties": {
          "mode": {
            "$ref": "#/components/schemas/Mode"
          },
          "collection": {
            "type": "string",
            "description": "Collection the query runs on; must be a key of `collections`. Letters, digits and _, starting with a letter, max 64."
          },
          "collections": {
            "description": "Collection name -> documents (MongoDB Extended JSON). May instead be a string of relaxed JSON (comments and /regex/flags literals allowed).",
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              },
              {
                "type": "string"
              }
            ]
          },
          "query": {
            "description": "find: {filter, projection?, sort?, limit?}; aggregate: array of stages; count: {filter?}; distinct: {key, filter?}; insert: {documents:[..]} or {document}; update: {filter, update, multi?, upsert?} (an update without operators replaces the document); delete: {filter, multi?}. listIndexes: {} or null.",
            "oneOf": [
              {
                "type": "object"
              },
              {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              {
                "type": "string",
                "description": "Relaxed JSON text; /pattern/flags regex literals allowed (flags i m x s u)."
              },
              {
                "type": "null"
              }
            ]
          },
          "explain": {
            "type": "string",
            "enum": [
              "queryPlanner",
              "executionStats",
              "allPlansExecution"
            ],
            "description": "Also return the query plan with the results. Not allowed for insert."
          },
          "indexes": {
            "description": "Indexes created after seeding and before the query, so explain can show IXSCAN. At most 3 per collection (the _id index does not count), 4 key fields each. May be relaxed JSON text.",
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/IndexSpec"
                  }
                }
              },
              {
                "type": "string"
              }
            ]
          },
          "datasource": {
            "type": "object",
            "description": "{\"sample\": \"sample_mflix\"} runs read-only against an Atlas sample database (find, aggregate, count, distinct). Omit `collections`. Results are capped at limits.sampleMaxResults and `truncated` is set.",
            "properties": {
              "sample": {
                "type": "string"
              }
            }
          },
          "searchIndexes": {
            "type": "object",
            "description": "One Atlas Search index per collection, built (and waited for) before the query so $search works. Needs Atlas or atlas local: see limits.searchSupported. Definition keys: mappings (required), analyzer, analyzers, searchAnalyzer, synonyms, storedSource.",
            "additionalProperties": {
              "type": "object",
              "required": [
                "definition"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "definition": {
                  "type": "object"
                }
              }
            }
          }
        }
      },
      "RunResponse": {
        "type": "object",
        "required": [
          "results",
          "elapsed_ms"
        ],
        "properties": {
          "results": {
            "type": "array",
            "items": {},
            "description": "Relaxed Extended JSON. Reads: matching documents (count returns [{count: n}], distinct the values). Writes: the collection after the write. Empty for /explain."
          },
          "elapsed_ms": {
            "type": "integer"
          },
          "write": {
            "type": "object",
            "description": "Counts for write modes; only applicable fields are present.",
            "properties": {
              "inserted": {
                "type": "integer"
              },
              "matched": {
                "type": "integer"
              },
              "modified": {
                "type": "integer"
              },
              "upserted": {
                "type": "integer"
              },
              "deleted": {
                "type": "integer"
              }
            }
          },
          "explain": {
            "$ref": "#/components/schemas/ExplainOutput"
          },
          "truncated": {
            "type": "boolean",
            "description": "Sample-data read hit the result cap."
          }
        }
      },
      "ValidateResponse": {
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "mode": {
            "$ref": "#/components/schemas/Mode"
          },
          "collection": {
            "type": "string"
          },
          "documentCounts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          }
        }
      },
      "Limits": {
        "type": "object",
        "properties": {
          "maxCollections": {
            "type": "integer"
          },
          "maxDocsPerCollection": {
            "type": "integer"
          },
          "maxPayloadBytes": {
            "type": "integer"
          },
          "maxTimeMs": {
            "type": "integer"
          },
          "maxResults": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Always null: there is no result cap."
          },
          "compression": {
            "type": "object",
            "description": "Content-Encodings accepted on requests and used on responses."
          },
          "apiVersion": {
            "type": "string"
          },
          "maxIndexesPerCollection": {
            "type": "integer"
          },
          "maxIndexKeyFields": {
            "type": "integer"
          },
          "maxRegexPatternLength": {
            "type": "integer"
          },
          "maxRegexLiteralsPerEditor": {
            "type": "integer"
          },
          "maxSearchIndexesPerCollection": {
            "type": "integer"
          },
          "searchWallClockMs": {
            "type": "integer"
          },
          "maxConcurrentSearchRuns": {
            "type": "integer"
          },
          "sampleMaxResults": {
            "type": "integer"
          },
          "maxShareBytes": {
            "type": "integer"
          },
          "shareTtlDays": {
            "type": "integer"
          },
          "searchSupported": {
            "type": "boolean"
          },
          "sampleSupported": {
            "type": "boolean"
          },
          "features": {
            "type": "object",
            "properties": {
              "sampleData": {
                "type": "boolean"
              }
            },
            "description": "Feature flags. sampleData is off by default (FEATURE_SAMPLE_DATA)."
          },
          "rateLimit": {
            "type": "object",
            "description": "Per-client token buckets: basic and verified tiers."
          },
          "turnstile": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "siteKey": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "deployment": {
            "type": "object",
            "properties": {
              "cluster": {
                "type": "string"
              }
            }
          }
        }
      },
      "Example": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "template",
              "example"
            ]
          },
          "config": {
            "type": "string"
          },
          "script": {
            "type": "string"
          },
          "datasource": {
            "type": "object"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "hint"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_request",
                  "forbidden",
                  "database_error",
                  "timeout",
                  "unavailable",
                  "busy",
                  "capacity",
                  "not_found",
                  "rate_limited"
                ]
              },
              "message": {
                "type": "string"
              },
              "hint": {
                "type": "string",
                "description": "A short next step for the caller."
              }
            }
          }
        }
      },
      "ExplainOutput": {
        "type": "object",
        "properties": {
          "raw": {
            "description": "The server's explain document (host details removed)."
          },
          "summary": {
            "type": "object",
            "properties": {
              "verbosity": {
                "type": "string"
              },
              "stages": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "indexUsed": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "collscan": {
                "type": "boolean"
              },
              "keysExamined": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "docsExamined": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "returned": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "executionTimeMs": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "advice": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "IndexSpec": {
        "type": "object",
        "required": [
          "key"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "object",
            "description": "field -> 1 | -1 | \"text\" | \"2dsphere\" | \"hashed\"; wildcard \"$**\" with 1 or -1.",
            "additionalProperties": {
              "oneOf": [
                {
                  "enum": [
                    1,
                    -1
                  ]
                },
                {
                  "enum": [
                    "text",
                    "2dsphere",
                    "hashed"
                  ]
                }
              ]
            }
          },
          "options": {
            "type": "object",
            "description": "Allowed: name, unique, sparse, expireAfterSeconds, partialFilterExpression, collation, weights, wildcardProjection, default_language, language_override, textIndexVersion, 2dsphereIndexVersion."
          }
        }
      },
      "ScriptRequest": {
        "type": "object",
        "required": [
          "script"
        ],
        "properties": {
          "script": {
            "type": "string",
            "description": "mongosh-style statements: db.people.find({age: {$gt: 30}}).sort({age: -1}). Several statements (max 25) run in order against one throwaway database. See /llms.txt for the supported methods and value syntax."
          },
          "config": {
            "description": "The data panel: [docs] (one collection named `collection`), db = {coll: [docs]}, or per collection {documents, indexes, searchIndexes, vectorSearchIndexes}. A JSON value or a string in shell syntax. `collections` is an alias.",
            "oneOf": [
              {
                "type": "object"
              },
              {
                "type": "array"
              },
              {
                "type": "string"
              }
            ]
          },
          "explain": {
            "type": "string",
            "enum": [
              "queryPlanner",
              "executionStats",
              "allPlansExecution"
            ],
            "description": "Explain the statements instead of running them (inserts and index builds still run)."
          },
          "datasource": {
            "type": "object",
            "properties": {
              "sample": {
                "type": "string"
              }
            },
            "description": "{\"sample\": \"sample_mflix\"}: read-only against an Atlas sample database."
          }
        }
      },
      "StatementOutput": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer"
          },
          "line": {
            "type": "integer"
          },
          "statement": {
            "type": "string"
          },
          "collection": {
            "type": "string"
          },
          "op": {
            "type": "string",
            "description": "find, aggregate, count, distinct, insert, update, delete, listIndexes, explain, createIndex, dropIndex, createSearchIndex"
          },
          "results": {
            "type": "array",
            "items": {}
          },
          "write": {
            "type": "object"
          },
          "explain": {
            "$ref": "#/components/schemas/ExplainOutput"
          },
          "truncated": {
            "type": "boolean"
          },
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          },
          "elapsed_ms": {
            "type": "integer"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message",
          "hint"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          }
        }
      },
      "ScriptResponse": {
        "type": "object",
        "required": [
          "ok",
          "statements"
        ],
        "description": "A transcript. If a statement fails the script stops there: ok is false and that statement has `error`.",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "statements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StatementOutput"
            }
          },
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          },
          "elapsed_ms": {
            "type": "integer"
          }
        }
      },
      "Playground": {
        "description": "A shell-style script request, or the older structured single-operation request.",
        "oneOf": [
          {
            "$ref": "#/components/schemas/ScriptRequest"
          },
          {
            "$ref": "#/components/schemas/RunRequest"
          }
        ]
      },
      "Reply": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/ScriptResponse"
          },
          {
            "$ref": "#/components/schemas/RunResponse"
          }
        ]
      }
    }
  }
}
