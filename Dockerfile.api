# syntax=docker/dockerfile:1
# One image: the Rust API plus the built web app (served from /app/web).

FROM node:26-slim AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM rust:1-slim-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock* ./
COPY crates ./crates
# The desktop app (src-tauri) is not part of the server image, so drop it from the workspace.
RUN sed -i 's/, "src-tauri"//' Cargo.toml
RUN cargo build --release -p playground-api

FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --uid 10001 app
COPY --from=build /src/target/release/api /usr/local/bin/api
COPY --from=web /web/dist /app/web
USER app
ENV PORT=8080 LOG_JSON=1 WEB_DIR=/app/web
EXPOSE 8080
CMD ["api"]
